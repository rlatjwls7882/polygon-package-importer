{
  "manifest_version": 3,
  "name": "__MSG_extensionName__",
  "version": "0.8.2",
  "default_locale": "en",
  "description": "__MSG_extensionDescription__",
  "minimum_chrome_version": "118",
  "action": {
    "default_title": "__MSG_extensionName__",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "src/runtime/background.js",
    "type": "module"
  },
  "permissions": [
    "storage",
    "offscreen"
  ],
  "host_permissions": [
    "https://polygon.codeforces.com/*"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
