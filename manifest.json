{
  "manifest_version": 3,
  "name": "Polygon Package Importer",
  "version": "0.5.2",
  "description": "Import Polygon problem packages from ZIP files.",
  "minimum_chrome_version": "118",
  "action": {
    "default_title": "Polygon Package Importer",
    "default_popup": "popup.html"
  },
  "options_ui": {
    "page": "index.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": ["storage", "offscreen"],
  "host_permissions": ["https://polygon.codeforces.com/*"],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
